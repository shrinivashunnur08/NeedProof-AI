GOOGLE_CLOUD_PROJECT=YOUR_ACTUAL_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-2.5-flash
AI_MODE=LIVE_VERTEX

# Local database configuration
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///./needproof_dev.db

# Development only
ENVIRONMENT=development
DEMO_WRITE_KEY=replace-this-with-a-long-random-local-secret

MAPS_API_KEY= 

ASSURANCE_OPERATOR_KEY=PASTE_YOUR_GENERATED_SECRET_HERE
# --- Commerce loop (Gemini agent, photo proof, demand insights) ---
# Profile: free (Gemini API key, local analytics) or google_full (Vertex AI, BigQuery)
NEEDPROOF_PROFILE=free
# ai_studio | vertex | mock. Without a key the app runs in mock mode.
GEMINI_BACKEND=ai_studio
GEMINI_API_KEY=
# Fast model with free-tier quota; any Gemini model name works
LOOP_GEMINI_MODEL=gemini-flash-lite-latest
# local | bigquery
ANALYTICS_BACKEND=local
BIGQUERY_DATASET=needproof_loop
